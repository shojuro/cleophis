{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cleophis",
  "version": "0.1.0",
  "identifier": "com.cleophis.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cleophis",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["$RESOURCE/**"] },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/catalog.json": "resources/catalog.json",
      "resources/covers/": "resources/covers/",
      "resources/llama/": "resources/llama/",
      "resources/embedders/": "resources/embedders/",
      "resources/pdfium/": "resources/pdfium/",
      "resources/ocr/": "resources/ocr/"
    }
  }
}
