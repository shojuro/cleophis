{
  "_comment": "dose-cite-v1 verdict fixtures, one named group per clause of the rule. Each case: a reply + a named source set (sources.json) -> the expected verdict fields. WITHHELD stands for lookup-guard.js's WITHHELD_BANNER and a displayText of exactly NO_EVIDENCE for LOOKUP_NO_EVIDENCE_TEXT. The canonical rule is src/triage/lookup-guard.js; the triage repo's probes/dose-cite.mjs vendors it and asserts identity group by group.",
  "groups": {
    "citation-range": [
      {
        "name": "a citation out of range withholds its sentence",
        "sources": "paracetamol",
        "replyText": "Paracetamol is a common painkiller [2]. It is safe in pregnancy [7].",
        "expected": {
          "outcome": "grounded",
          "displayText": "Paracetamol is a common painkiller [2]. WITHHELD",
          "kept": [
            "Paracetamol is a common painkiller [2]."
          ],
          "withheld": [
            {
              "sentence": "It is safe in pregnancy [7].",
              "reason": "citation-out-of-range"
            }
          ],
          "citations": [
            2
          ]
        }
      },
      {
        "name": "citation [0] is out of range",
