# Cleophis distribution pipeline — copy this file to `.env` (gitignored,
# never commit it) in this same directory and fill in real values.
#
# Every pipeline script is env-dumb: it reads ONLY these vars (via `.env`)
# plus its own CLI args — no other implicit machine/repo state. See
# README.md for the full inputs -> outputs -> hashes contract per script.

# Backblaze B2 (S3-compatible) application key credentials, used by A3
# (build_adapter.py: PEFT pull), A5 (publish.py: upload + archive), and A6
# (verify_published.py) to read/write the cleophis-dist and cleophis-models
# buckets.
#
# TWO SCOPED KEY PAIRS, because B2 application keys are bucket-scoped (one
# key can't cover both buckets unless it's deliberately created as an
# all-buckets key):
#
#   - B2_KEY_ID / B2_APP_KEY is the PRIMARY pair, scoped to the cleophis-dist
#     bucket (read+write). Used for publish.py's destination-bucket ops:
#     artifact HEAD/uploads and the live catalog.json/.sig GET/PUT. This
#     pair is always required for a live publish.
#   - B2_MODELS_KEY_ID / B2_MODELS_APP_KEY is the MODELS pair, scoped to the
#     cleophis-models bucket (read+write). Used for build_adapter.py's PEFT
#     pull AND publish.py's archive-copy puts (the superseded catalog
#     archived to cleophis-models before the new one goes live).
#   - FALLBACK: if B2_MODELS_KEY_ID/B2_MODELS_APP_KEY are absent or empty,
#     both roles above use the PRIMARY pair instead — this preserves a
#     single all-buckets-key setup for operators who haven't split their
#     keys into two scoped ones.
B2_KEY_ID=
B2_APP_KEY=
B2_MODELS_KEY_ID=
B2_MODELS_APP_KEY=

# S3-compatible endpoint for the B2 account/region hosting those buckets,
# e.g. https://s3.us-west-004.backblazeb2.com — boto3 talks to B2 through
# this, not through B2's native API. Shared by BOTH key pairs above: B2's
# S3-compatible endpoint is per-account/region, not per-bucket — it's the
# app keys that are bucket-scoped, not the endpoint.
B2_ENDPOINT=

# Hugging Face access token. Only required if the base model or adapter
# source repo (A2/A3) is gated/private; public repos work with this unset.
HF_TOKEN=

# Path to the curator ed25519 PRIVATE key file. This is the one credential
# that does NOT live in .env as a value — only its file PATH does, and that
# path MUST point OUTSIDE this repo (e.g. ~/.cleophis/curator_ed25519.key),
# with restrictive file permissions (chmod 600). It is read ONLY by the
# sign_catalog.py step (A4); no other pipeline script touches it. Never
# paste the key material itself into .env, and never commit the key file.
CURATOR_KEY_FILE=
