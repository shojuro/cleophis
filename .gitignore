node_modules/
# Env files never belong in the repo — tooling reads ~/.env (home dir).
# This is a defense-in-depth net against a repo-local .env ever being added.
.env
.env.*
# Cargo build output. The workspace (RAG milestone) builds into a single
# root `target/`; the src-tauri path is kept for any pre-workspace checkouts.
/target/
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/resources/models/*.gguf
src-tauri/resources/llama/
src-tauri/resources/embedders/*.gguf
src-tauri/resources/pdfium/*.dll
models-lab/
tools/covers/out/
*.log

# Model-distribution pipeline (tools/pipeline/, task A1+): its own gitignored
# .env (see .env.* above — this is belt-and-suspenders since that pattern
# already matches it), the Python venv, the pinned llama.cpp checkout +
# prebuilt llama-quantize (all fetched by setup_tools.sh, never committed),
# and its large-scratch working directory.
tools/pipeline/.env
tools/pipeline/.venv/
tools/pipeline/llama.cpp/
tools/pipeline/work/
# .env.* above would also match .env.example; explicitly un-ignore it so the
# committed template stays trackable.
!tools/pipeline/.env.example
