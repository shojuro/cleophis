node_modules/
# Env files never belong in the repo — tooling reads ~/.env (home dir).
# This is a defense-in-depth net against a repo-local .env ever being added.
.env
.env.*
# Cargo build output. The workspace (RAG milestone) builds into a single
# root `target/`; the src-tauri path is kept for any pre-workspace checkouts.
/target/
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/resources/models/*.gguf
src-tauri/resources/llama/
src-tauri/resources/embedders/*.gguf
src-tauri/resources/pdfium/*.dll
# fetched OCR runtime (tesseract binary + traineddata) — never committed, like resources/pdfium/
src-tauri/resources/ocr/
models-lab/
tools/covers/out/
*.log

# Model-distribution pipeline (tools/pipeline/, task A1+): its own gitignored
# .env (see .env.* above — this is belt-and-suspenders since that pattern
# already matches it), the Python venv, the pinned llama.cpp checkout +
# prebuilt llama-quantize (all fetched by setup_tools.sh, never committed),
# and its large-scratch working directory.
tools/pipeline/.env
tools/pipeline/.venv/
tools/pipeline/llama.cpp/
tools/pipeline/work/
# .env.* above would also match .env.example; explicitly un-ignore it so the
# committed template stays trackable.
!tools/pipeline/.env.example

# generated datasets (synthetic) — never committed
tools/dataset/work/

# NHS reference corpus fetch cache (tools/reference/fetch_nhs.py): raw HTML, never committed —
# the extracted corpus under tools/reference/corpus/ is what is committed.
tools/reference/.cache/

# The bundled NHS reference pack (Phase 1h M4b): built by `kpack-cli
# build-reference` and signed by the founder, never committed — it rebuilds
# byte-identically from the committed corpus (docs/superpowers/mobile-tools/
# build-reference-pack.md). The contract files next to it, chunks.jsonl and
# titles.json, ARE committed.
tools/reference/build/*.kpack
tools/reference/build/*.kpack.sig
tools/reference/build/*.part
src-tauri/resources/packs/*.kpack
src-tauri/resources/packs/*.kpack.sig

# secrets and phone exports (security review 2026-10-04 P06): a `git add -A` must not
# publish signing keys or on-device journey dumps. `node_modules` has no trailing slash
# on purpose: the root node_modules here is a symlink, which `node_modules/` does not match.
node_modules
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
device-journey-*/
device-journey-*.zip
*.apk
*.aab
