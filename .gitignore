node_modules/
# Env files never belong in the repo — tooling reads ~/.env (home dir).
# This is a defense-in-depth net against a repo-local .env ever being added.
.env
.env.*
# Cargo build output. The workspace (RAG milestone) builds into a single
# root `target/`; the src-tauri path is kept for any pre-workspace checkouts.
/target/
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/resources/models/*.gguf
src-tauri/resources/llama/
src-tauri/resources/embedders/*.gguf
models-lab/
tools/covers/out/
*.log
